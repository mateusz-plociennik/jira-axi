{
  "name": "@mateusz-plociennik/jira-axi",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "description": "AXI-compliant jira-cli wrapper — non-interactive by default, plain-text output, agent-friendly error messages",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mateusz-plociennik/jira-axi.git"
  },
  "keywords": [
    "jira",
    "cli",
    "agent",
    "axi",
    "jira-cli"
  ],
  "bin": {
    "jira-axi": "./dist/bin/jira-axi.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx bin/jira-axi.ts",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axi-sdk-js": "^0.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
